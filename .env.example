# 服务端口
PORT=3001

# ===== 自己部署 / OpenAI 兼容模型配置 =====
# 注意：这里要填到 /v1，不要填完整的 /v1/chat/completions
# 例如 Ollama: http://localhost:11434/v1
# 例如 vLLM: http://localhost:8000/v1
# 例如 LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=your-model-name

# 很多自部署 OpenAI 兼容服务不会校验 Key，但 OpenAI SDK 需要传一个值。
# 如果你的服务不校验，可以保持 EMPTY；如果有鉴权，填真实 Key。
LLM_API_KEY=EMPTY

# 如果你的自部署服务不支持 response_format: { type: "json_object" }，改成 none
# 支持则可以保持 json_object 或删除此行
LLM_RESPONSE_FORMAT=none

# 可选：部分模型只支持默认 temperature=1，不允许传 0.7。
# 默认不传 temperature；如果你的模型支持并且想自定义，再取消注释。
# LLM_TEMPERATURE=1

# 可选：请求超时时间，单位毫秒
LLM_TIMEOUT_MS=60000

# ===== 如果以后想切回 OpenAI 官方，也可以使用下面这些旧变量 =====
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
